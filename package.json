{
  "name": "podsnieznikiem",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --hot apps/server/src/core/server.ts",
    "dev:client": "bun run --cwd apps/client dev",
    "start": "bun run apps/server/src/core/server.ts",
    "db:up": "docker compose up -d --wait",
    "db:seed": "bun run apps/server/src/core/seed.ts",
    "gen:api": "bun run scripts/gen-api.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/client",
    "test": "bun run test:server && bun run test:client",
    "test:server": "bun test apps/server packages",
    "test:client": "bun test --cwd apps/client",
    "lint": "eslint .",
    "build:client": "bun run --cwd apps/client build",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "check:api": "bun run gen:api && git diff --exit-code apps/client/src/generated/api.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
